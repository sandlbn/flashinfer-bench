# API configuration for the kernel generator.
# Copy to .env and fill in. Pick ONE block.

# ---------------------------------------------------------------------------
# Claude on Microsoft Foundry (Azure AI Foundry)
# ---------------------------------------------------------------------------
# Foundry serves Claude models at standard Anthropic API rates. Two ways to
# reach them; which you want depends on the client the generator uses.
#
# (a) OpenAI-compatible endpoint — works with the generator as written today,
#     since it constructs openai.AsyncOpenAI(api_key=..., base_url=...).
LLM_API_KEY=your_foundry_api_key
BASE_URL=https://<your-resource>.services.ai.azure.com/openai/v1
#     model_name in kernel_generator_example.py = your Foundry deployment name.
#
# (b) Native Anthropic SDK via AnthropicFoundry — adaptive thinking, effort
#     control, and first-party model IDs. Requires a small client change in
#     kernel_generator.py (see ANTHROPIC_FOUNDRY_RESOURCE below).
# ANTHROPIC_API_KEY=your_foundry_api_key
# ANTHROPIC_FOUNDRY_RESOURCE=<your-resource>
#     model_name = claude-opus-5

# ---------------------------------------------------------------------------
# Anthropic first-party API
# ---------------------------------------------------------------------------
# LLM_API_KEY=sk-ant-...
# BASE_URL=https://api.anthropic.com/v1/
#     model_name = claude-opus-5

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
# LLM_API_KEY=sk-...
#     model_name = gpt-5-2025-08-07   (BASE_URL not needed)

# ---------------------------------------------------------------------------
# Gemini
# ---------------------------------------------------------------------------
# LLM_API_KEY=your_gemini_api_key
# BASE_URL=https://generativelanguage.googleapis.com/v1beta/
